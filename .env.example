# --- Web (Next.js) ---
NEXT_PUBLIC_SITE_NAME="Primex AI Store"
NEXT_PUBLIC_AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_URL="http://localhost:8000"

# --- AI service (FastAPI) ---
AI_PROVIDER="stub"
# AI_PROVIDER options: stub | openai | anthropic | local

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

LOCAL_BASE_URL="http://localhost:11434/v1"
LOCAL_MODEL="llama3.1"

# --- Data stores ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/primex"
REDIS_URL="redis://localhost:6379"

# --- Stellar / Soroban ---
STELLAR_NETWORK="testnet"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ESCROW_CONTRACT_ID="CBBWLHEI3HUBZOVHCKSYGARLRGZYQ4VZCHYBYAIQN2A727J3COI7LMOQ"
STELLAR_MERCHANT_ADDRESS=""
# Stellar Asset Contract used for checkout. Derive/create one with
# `pnpm --filter @repo/stellar setup:sac` (see docs/stellar.md).
STELLAR_TOKEN_CONTRACT_ID=""
NEXT_PUBLIC_STELLAR_NETWORK="testnet"

# --- Test asset for SAC setup (setup:sac) ---
# The issuer must be funded on the target network. Never commit a real secret.
STELLAR_ASSET_CODE=""
STELLAR_ASSET_ISSUER=""
STELLAR_ASSET_ISSUER_SECRET=""

# --- Indexer ---
INDEXER_START_LEDGER="0"
INDEXER_POLL_MS="5000"
ORDERS_WEBHOOK_URL="http://localhost:3000/api/orders"
ORDERS_WEBHOOK_SECRET=""

# --- Orders store ---
ORDERS_FILE=".data/orders.json"
