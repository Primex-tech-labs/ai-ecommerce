{
  "name": "ai-ecommerce",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted storefront framework (Next.js + FastAPI, turborepo)",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "ai:dev": "uvicorn app.main:app --reload --port 8000 --app-dir apps/ai-service",
    "ai:test": "python -m pytest apps/ai-service/tests"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
